# ──────────────────────────────────────────────────────────────────────────────
# Mental Outline VPN Platform — environment variable template
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# On Replit, set these values via the Secrets panel (padlock icon).
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot Token — obtain from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs that have admin access
ADMIN_IDS=123456789,987654321

# Secret key for signing session tokens and HMAC payloads (long random string)
SESSION_SECRET=change_me_to_a_long_random_secret_string

# ── Database ──────────────────────────────────────────────────────────────────

# Development (SQLite — default when BOT_DATABASE_URL is not set):
# BOT_DATABASE_URL=sqlite+aiosqlite:///./data/mental_vpn.db

# Production (PostgreSQL):
# BOT_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mental_vpn

# ── Application ───────────────────────────────────────────────────────────────

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Default UI language for new users: en | my
DEFAULT_LANGUAGE=en

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Bot Identity ──────────────────────────────────────────────────────────────

# Display name shown in welcome messages and notifications
BOT_NAME=Mental VPN

# Telegram @username of the support contact (without the '@' prefix)
# SUPPORT_USERNAME=your_support_handle

# ── Localisation & Time ───────────────────────────────────────────────────────

# IANA timezone for display and scheduling
TIMEZONE=Asia/Yangon

# ── Commerce ──────────────────────────────────────────────────────────────────

# Currency code used for price display (e.g. MMK, USD, THB)
DEFAULT_CURRENCY=MMK

# ── Outline VPN API ───────────────────────────────────────────────────────────

# HTTP request timeout in seconds for Outline Management API calls
OUTLINE_API_TIMEOUT=10

# ── Resilience ────────────────────────────────────────────────────────────────

# Maximum automatic retries for transient failures
MAX_RETRY=3
