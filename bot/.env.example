# ──────────────────────────────────────────────────────────────────────────────
# Mental Outline VPN Platform — environment variable template
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# On Replit, set these values via the Secrets panel (padlock icon).
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot Token — obtain from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs that have admin access
ADMIN_IDS=123456789,987654321

# ── Database ──────────────────────────────────────────────────────────────────

# Development (SQLite — default when DATABASE_URL is not set):
# DATABASE_URL=sqlite+aiosqlite:///./data/mental_vpn.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mental_vpn

# ── Application ───────────────────────────────────────────────────────────────

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Default UI language for new users: en | my
DEFAULT_LANGUAGE=en

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
